{"properties":[{"propertyId":"p_845962eb2682408b9cf9a19087f1f931","reference":"296706","title":{"fr":null,"nl":"Landelijke woning rustig in groene omgeving - projectgrond","de":null,"en":null},"description":{"fr":null,"nl":"Deze landelijke woning gelegen in agrarisch gebied is perfect voor een project van sloop -en heropbouw. \nDe stedenbouwkundige functie is reeds gekend als woning, waardoor er geen functiewijziging naar residentieel wonen meer nodig is. Bij sloop en heropbouw gelden de regels van zonevreemd bouwen: Er kan gebruik gemaakt worden van art 2.7 ( zie pagina 7-8 van het algemeen plan van aanleg), te weten maximaal 1.200 m³ bouwvolume en 250 m²grondoppervlakte voor wat betreft de woning. Op zich kan men de nieuwe woning binnen een straal van 30 m heroptrekken. Voor specifieke plannen gelieve contact op te nemen met de dienst stedenbouw van de stad Roeselare. ","de":null,"en":null},"propertyType":"HOUSE","propertyTypeOtherDescription":null,"propertySubtype":"HOUSE","address":{"countryCode":"BE","estateBoxNumber":null,"estateNumber":"14","locality":null,"municipality":{"fr":"Rumbeke","nl":"Rumbeke","de":"Rumbeke","en":"Rumbeke"},"postalCode":"8800","street":{"fr":"Penemolenstraat","nl":"Penemolenstraat","de":"Penemolenstraat","en":"Penemolenstraat"}},"contact":{"firstName":"Gauthier","lastName":"SNOECK","email":"info@notariaatvs.be","phoneNumber":"(051) 20.26.16"},"geoLocation":{"lat":50.894285,"lng":3.1505727},"pictures":[{"pictureId":"pp_0dff41a874be4833ada9c0409dc864e2","orderIndex":2,"name":"DJI_0248.jpg","small":"https://www.biddit.be/stg/eco/images/p_845962eb2682408b9cf9a19087f1f931/s/pp_0dff41a874be4833ada9c0409dc864e2.jpeg","medium":"https://www.biddit.be/stg/eco/images/p_845962eb2682408b9cf9a19087f1f931/m/pp_0dff41a874be4833ada9c0409dc864e2.jpeg","large":"https://www.biddit.be/stg/eco/images/p_845962eb2682408b9cf9a19087f1f931/l/pp_0dff41a874be4833ada9c0409dc864e2.jpeg","fbc":"https://www.biddit.be/stg/eco/images/p_845962eb2682408b9cf9a19087f1f931/